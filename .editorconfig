root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{json,toml,yml,gyp}]
indent_style = space
indent_size = 2

[*.{js,ts}]
indent_style = space
indent_size = 2

[*.scm]
indent_style = space
indent_size = 2

[*.{c,cc,h}]
indent_style = space
indent_size = 4

# Generated by tree-sitter
[parser.c]
indent_size = 2

[{alloc,array,parser}.h]
indent_size = 2
