{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ucode",
      "camelcase": "Ucode",
      "scope": "source.uc",
      "path": "ucode",
      "external-files": [
        "common/scanner.h"
      ],
      "file-types": [
        "ucode",
        "uc"
      ],
      "first-line-regex": "^#!.*\\bucode\\b",
      "highlights": [
        "ucode/queries/highlights.scm"
      ],
      "locals": [
        "ucode/queries/locals.scm"
      ],
      "injections": [
        "ucode/queries/injections.scm"
      ],
      "tags": [
        "ucode/queries/tags.scm"
      ],
      "injection-regex": "^ucode$"
    },
    {
      "name": "ucode_markup",
      "camelcase": "UcodeMarkup",
      "scope": "source.ucode.markup",
      "path": "ucode_markup",
      "external-files": [
        "common/scanner.h"
      ],
      "file-types": [
        "ucode",
        "uc",
        "ut"
      ],
      "content-regex": "(?m)^\\s*\\{[%{#]",
      "highlights": [
        "ucode_markup/queries/highlights.scm"
      ],
      "locals": [
        "ucode_markup/queries/locals.scm"
      ],
      "injections": [
        "ucode_markup/queries/injections.scm"
      ],
      "tags": [
        "ucode_markup/queries/tags.scm"
      ],
      "injection-regex": "^ucode_markup$"
    },
    {
      "name": "ucdocs",
      "camelcase": "Ucdocs",
      "scope": "source.ucdocs",
      "path": "ucdocs",
      "highlights": [
        "ucdocs/queries/highlights.scm"
      ],
      "tags": [
        "ucdocs/queries/tags.scm"
      ],
      "injection-regex": "^ucdocs$"
    }
  ],
  "metadata": {
    "version": "0.8.0",
    "license": "MIT",
    "description": "Ucode grammar for tree-sitter",
    "authors": [
      {
        "name": "António Mora"
      }
    ],
    "links": {
      "repository": "https://github.com/m00qek/tree-sitter-ucode"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
