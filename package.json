{
  "name": "tree-sitter-ucode",
  "version": "0.8.0",
  "description": "Ucode grammar for tree-sitter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m00qek/tree-sitter-ucode.git"
  },
  "license": "MIT",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "ucode",
    "openwrt"
  ],
  "files": [
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "common/define-grammar.js",
    "common/scanner.h",
    "ucode/grammar.js",
    "ucode/src/**",
    "ucode/queries/*",
    "ucode/test/corpus/**",
    "ucode_markup/grammar.js",
    "ucode_markup/src/**",
    "ucode_markup/queries/*",
    "ucode_markup/test/corpus/**",
    "scripts/generate-markup-queries.js",
    "scripts/checks.js",
    "scripts/run-tests.js",
    "scripts/tree-sitter-cli.js",
    "scripts/validate-corpus.js",
    "scripts/validate-docs.js",
    "ucdocs/grammar.js",
    "ucdocs/src/**",
    "ucdocs/queries/*",
    "ucdocs/test/corpus/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "node scripts/generate-markup-queries.js && node scripts/generate-helix-queries.js && tree-sitter generate ucode/grammar.js --output ucode/src && tree-sitter generate ucode_markup/grammar.js --output ucode_markup/src && tree-sitter generate ucdocs/grammar.js --output ucdocs/src && node-gyp-build && node scripts/run-tests.js --build-only",
    "test": "node scripts/run-tests.js",
    "test:bindings": "node --test bindings/node/binding_test.js",
    "prestart": "tree-sitter build --wasm --output ucode/tree-sitter-ucode.wasm ucode",
    "start": "tree-sitter playground --grammar-path ucode"
  }
}
